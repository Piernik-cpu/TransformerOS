[Desktop Entry]
Name=Package Manager
GenericName=Software Center
Comment=Install and manage Fedora RPM apps, Flatpaks (Flathub), and AppImages
Exec=/usr/bin/transformer-store %f
Icon=system-software-install
Terminal=false
Type=Application
Categories=System;PackageManager;Settings;
Keywords=store;software;packages;dnf;rpm;flatpak;flathub;appimage;install;update;
MimeType=application/vnd.appimage;application/x-iso9660-appimage;
StartupNotify=true
