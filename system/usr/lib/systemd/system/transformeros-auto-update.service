[Unit]
Description=TransformerOS Atomic Image Background Stage (No Auto-Reboot)
Wants=network-online.target
After=network-online.target
ConditionACPower=true

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
ExecCondition=/bin/sh -c '! grep -qs "^game_mode=true$" /home/*/.config/transformeros/config.kv'
ExecStart=/usr/bin/bootc upgrade
