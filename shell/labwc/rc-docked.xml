<?xml version="1.0"?>
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <adaptiveSync>no</adaptiveSync>
    <allowTearing>no</allowTearing>
  </core>
  <theme>
    <name>Adwaita</name>
    <cornerRadius>8</cornerRadius>
    <font name="Sans" size="11" />
  </theme>
  <desktops number="2" />
  <touch deviceName="SIS0817:00 0457:1071" mapToOutput="DSI-1" mouseEmulation="no" />
  <libinput>
    <device category="touchpad">
      <naturalScroll>yes</naturalScroll>
      <tap>yes</tap>
      <scrollFactor>0.45</scrollFactor>
      <dwt>yes</dwt>
    </device>
  </libinput>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="/usr/bin/transformer-shell appgrid" /></keybind>
    <keybind key="Super_R" onRelease="yes"><action name="Execute" command="/usr/bin/transformer-shell appgrid" /></keybind>
    <keybind key="XF86HomePage"><action name="Execute" command="/usr/bin/transformer-shell appgrid" /></keybind>
    <keybind key="W-d"><action name="Execute" command="/usr/bin/transformer-shell appgrid" /></keybind>
    <keybind key="W-space"><action name="Execute" command="/usr/bin/transformer-shell appgrid" /></keybind>
    <keybind key="W-Tab"><action name="Execute" command="/usr/bin/transformer-shell recents" /></keybind>
    <keybind key="W-s"><action name="Execute" command="/usr/bin/transformer-shell qs" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-e"><action name="Execute" command="pcmanfm" /></keybind>
    <keybind key="W-b"><action name="Execute" command="firefox" /></keybind>
    <keybind key="W-k"><action name="Execute" command="transformerd osk toggle" /></keybind>
    <keybind key="W-r"><action name="Execute" command="transformerd rotate toggle" /></keybind>
    <keybind key="W-g"><action name="Execute" command="transformerd gamemode toggle" /></keybind>
    <keybind key="W-m"><action name="Execute" command="transformerd mode toggle" /></keybind>
    <keybind key="W-l"><action name="Execute" command="/usr/bin/transformer-shell lock" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="transformerd brightness +5" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="transformerd brightness -5" /></keybind>
    <keybind key="Print"><action name="Execute" command="grim" /></keybind>
  </keyboard>
</labwc_config>
