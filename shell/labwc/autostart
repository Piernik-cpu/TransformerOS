#!/usr/bin/env bash
# TransformerOS Session Autostart

# Background wallpaper (solid deep slate for zero VRAM overhead)
swaybg -c '#0f1624' >/dev/null 2>&1 &

# Start transformerd hardware/mode/sensor/power daemon
transformerd daemon >/dev/null 2>&1 &

# Persistent Quickshell desktop shell (TopBar, QuickSettings, AppGrid, BottomNav, Polkit, Notifications, WlSessionLock)
quickshell -c transformeros >/dev/null 2>&1 &

# Idle management: dim/blank screen after 5m, lock after 10m
swayidle -w \
    timeout 300 'wlopm --off \*' \
    resume 'wlopm --on \*' \
    timeout 600 '/usr/bin/transformer-shell lock' >/dev/null 2>&1 &

# Optional user customization hook
if [ -x "$HOME/.config/transformeros/custom-autostart.sh" ]; then
    "$HOME/.config/transformeros/custom-autostart.sh" >/dev/null 2>&1 &
fi
